# Copy to .env (deploy/setup_server.sh creates it automatically on the server).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=thingbd.com,www.thingbd.com
CSRF_TRUSTED_ORIGINS=https://thingbd.com,https://www.thingbd.com
# true once the site is served over HTTPS (secure cookies); false for plain http://IP
USE_HTTPS=true
TIME_ZONE=Asia/Dhaka

# Where data lives (defaults to the project folder)
#DATABASE_PATH=/srv/thingbd/data/db.sqlite3
#MEDIA_ROOT=/srv/thingbd/media
#STATIC_ROOT=/srv/thingbd/static

# SMTP for lead notification emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Thingbd <no-reply@thingbd.com>
