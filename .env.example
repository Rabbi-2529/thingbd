# Copy to .env and fill in for production.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=thingbd.com,www.thingbd.com
CSRF_TRUSTED_ORIGINS=https://thingbd.com,https://www.thingbd.com
TIME_ZONE=Asia/Dhaka

# SMTP for lead notification emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Thingbd <no-reply@thingbd.com>
